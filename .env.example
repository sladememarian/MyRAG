# Copy this file to .env and fill in your own values:  cp .env.example .env
# ------------------------------------------------------------------ Django
# Local Docker development. Set DEBUG=False in production.
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,testserver
# With DEBUG=False, HTTPS redirect, secure cookies and HSTS turn on by default.
# Override only if TLS terminates elsewhere or you need a temporary exception.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# TRUST_X_FORWARDED_PROTO=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
# Required: docker-compose.yml has no fallback password (a committed default is
# a real credential). Generate one with: python -c "import secrets; print(secrets.token_urlsafe(24))"
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------- Admin bootstrap
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-too

# ---------------------------------------------------------------- OpenRouter
# Create a key at https://openrouter.ai/keys and pick a ":free" model at
# https://openrouter.ai/models?max_price=0
# Use the OpenAI-compatible base URL. Do not append /responses or /chat/completions.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-own-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free

# ------------------------------------------------------------- Itera Compute
# OpenAI-compatible API; the "Auto" model lets the provider route the request.
# The admin (Model Management) can hold several keys per provider and chooses
# which model answers. These values are the fallback / import source.
ITERACOMPUTE_API_KEY=ick_live_replace-with-your-own-key
ITERACOMPUTE_BASE_URL=https://api.iteracompute.com/v1
ITERACOMPUTE_MODEL=Auto

TOKENHARBOR_API_KEY=thk_live_replace-with-your-own-key
TOKENHARBOR_BASE_URL=https://tokenharbor.ai/v1
TOKENHARBOR_MODEL=

ORCAROUTER_API_KEY=sk-orca-replace-with-your-own-key
ORCAROUTER_BASE_URL=https://api.orcarouter.ai/v1
ORCAROUTER_MODEL=orcarouter/free

# ------------------------------------------------------- LLM client settings
# Timeout and retries are shared by both providers. The OpenAI SDK retries
# 429/5xx/timeouts; on top of that the app rotates through the provider's keys.
LLM_TIMEOUT=60
LLM_MAX_TOKENS=800
LLM_TEMPERATURE=0.0
LLM_MAX_RETRIES=3
# Optional: OpenRouter uses this URL only for its public rankings page.
# OPENROUTER_SITE_URL=https://your-site.example

# ------------------------------------------------------------------- Proxy
# Route outbound LLM calls through a local proxy. Set only the parts that
# change; inside Docker 127.0.0.1 is rewritten to host.docker.internal for you.
# Leave LLM_PROXY_HOST empty to go direct. LLM_PROXY (a full URL) wins over the
# three values below; it supports http://, https:// and socks5://.
# Examples:
#   LLM_PROXY=http://127.0.0.1:14927
#   LLM_PROXY=socks5://127.0.0.1:14926
LLM_PROXY=
LLM_PROXY_SCHEME=http
LLM_PROXY_HOST=
LLM_PROXY_PORT=

# ------------------------------------------------------ API keys at rest
# Encrypts provider keys stored in the admin. Empty = derive from SECRET_KEY.
# Set a separate value if you plan to rotate SECRET_KEY.
SECRET_ENCRYPTION_KEY=

# ------------------------------------------------------- Embeddings / Chroma
# sentence-transformers = real local model; fake = deterministic embeddings for tests.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=documents

# ---------------------------------------------------------------------- RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_LAMBDA=0.5
# Off by default: multi-query adds an extra LLM call per question.
RETRIEVAL_USE_MULTI_QUERY=False
MULTI_QUERY_COUNT=3
# Chunks below this 0..1 score are ignored (0 disables the filter).
RETRIEVAL_MIN_SCORE=0.2
CONTEXT_MAX_CHARS=6000
MAX_DOCUMENT_SIZE_MB=10

# ------------------------------------------------------------- API limits
# Per-user limit for POST /api/ask/. Empty disables throttling.
ASK_THROTTLE_RATE=20/min

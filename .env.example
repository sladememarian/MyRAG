# Copy this file to .env and fill in your own values:  cp .env.example .env
# ------------------------------------------------------------------ Django
# Local Docker development. Set DEBUG=False in production.
DEBUG=True
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web,testserver
# With DEBUG=False, HTTPS redirect, secure cookies and HSTS turn on by default.
# Override only if TLS terminates elsewhere or you need a temporary exception.
# SECURE_SSL_REDIRECT=True
# SESSION_COOKIE_SECURE=True
# CSRF_COOKIE_SECURE=True
# SECURE_HSTS_SECONDS=31536000
# TRUST_X_FORWARDED_PROTO=True
# CSRF_TRUSTED_ORIGINS=https://your-domain.example

# ---------------------------------------------------------------- Postgres
POSTGRES_DB=ragdb
POSTGRES_USER=raguser
POSTGRES_PASSWORD=ragpass
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---------------------------------------------------------- Admin bootstrap
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=change-me-too

# ---------------------------------------------------------------- OpenRouter
# Create a key at https://openrouter.ai/keys and pick a ":free" model at
# https://openrouter.ai/models?max_price=0
# Use the OpenAI-compatible base URL. Do not append /responses or /chat/completions.
OPENROUTER_API_KEY=sk-or-v1-replace-with-your-own-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=inclusionai/ling-3.2-flash:free
# Optional proxy. Inside Docker use host.docker.internal instead of 127.0.0.1.
OPENROUTER_PROXY=
OPENROUTER_TIMEOUT=60
OPENROUTER_MAX_TOKENS=800

# ------------------------------------------------------- Embeddings / Chroma
# sentence-transformers = real local model; fake = deterministic embeddings for tests.
EMBEDDING_BACKEND=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2
EMBEDDING_DEVICE=cpu
CHROMA_DIR=./chroma_db
CHROMA_COLLECTION=documents

# ---------------------------------------------------------------------- RAG
CHUNK_SIZE=800
CHUNK_OVERLAP=120
RETRIEVAL_K=5
RETRIEVAL_FETCH_K=20
RETRIEVAL_LAMBDA=0.5
# Off by default: multi-query adds an extra LLM call per question.
RETRIEVAL_USE_MULTI_QUERY=False
MULTI_QUERY_COUNT=3
# Chunks below this 0..1 score are ignored (0 disables the filter).
RETRIEVAL_MIN_SCORE=0.2
CONTEXT_MAX_CHARS=6000
MAX_DOCUMENT_SIZE_MB=10

# ------------------------------------------------------------- API limits
# Per-user limit for POST /api/ask/. Empty disables throttling.
ASK_THROTTLE_RATE=20/min
